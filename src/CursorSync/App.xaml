<Application x:Class="CursorSync.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CursorSync.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBoolConverter x:Key="InverseBool"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
            <converters:NullOrEmptyToVisibilityConverter x:Key="NullToVis"/>
            <converters:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
            <converters:PageEqualsConverter x:Key="PageEquals"/>
            <converters:EnumEqualsConverter x:Key="EnumEquals"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

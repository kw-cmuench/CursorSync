<UserControl x:Class="CursorSync.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,24">
        <StackPanel>
            <StackPanel Style="{StaticResource PageHeader}">
                <TextBlock Text="Dashboard" Style="{StaticResource TitleText}"/>
                <TextBlock Style="{StaticResource PageLead}"
                           Text="Keep chats, agents, and editor data aligned across your Windows machines — and choose exactly what travels."/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" HorizontalAlignment="Left" FontSize="18"/>
                        <TextBlock Text="Sync folder" Style="{StaticResource CaptionText}" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding HubStatusText}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding HubDetailText}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="&#xE7EE;" Style="{StaticResource Glyph}" HorizontalAlignment="Left" FontSize="18"/>
                        <TextBlock Text="Cursor" Style="{StaticResource CaptionText}" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding CursorStatusText}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CursorDetailText}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" HorizontalAlignment="Left" FontSize="18"/>
                        <TextBlock Text="Last sync" Style="{StaticResource CaptionText}" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding LastSyncText}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LastSyncDetail}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Cursor data health" Style="{StaticResource SectionText}"/>
                        <TextBlock Text="{Binding IntegritySummary}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding IntegrityDetail}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                        <ItemsControl ItemsSource="{Binding IntegrityIssues}" Margin="0,10,0,0"
                                      Visibility="{Binding HasIntegrityIssues, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Check now" Style="{StaticResource GhostButton}" VerticalAlignment="Top"
                            Command="{Binding CheckCursorDataCommand}"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Quick sync" Style="{StaticResource SectionText}"/>
                        <TextBlock Margin="0,6,0,14" Style="{StaticResource MutedText}"
                                   Text="{Binding EnabledSummary}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Two-way sync" Style="{StaticResource PrimaryButton}" Command="{Binding TwoWayNowCommand}"/>
                            <Button Content="Push to folder" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding PushNowCommand}"/>
                            <Button Content="Pull to this PC" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding PullNowCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Selected data" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding TotalSizeText}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding MachineName}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Enabled categories" Style="{StaticResource SectionText}"/>
                            <Button Content="Manage" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="12,6"
                                    Command="{Binding NavigateCommand}" CommandParameter="Categories"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Categories}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Tips" Style="{StaticResource SectionText}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                                   Text="Quit Cursor before syncing chats. SQLite databases can corrupt if both PCs write at once."/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                                   Text="Chats attach to the project path. Use the same folder path on both machines, or set a path rewrite in Settings."/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

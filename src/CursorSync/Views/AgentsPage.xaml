<UserControl x:Class="CursorSync.Views.AgentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,12,16">
            <StackPanel>
                <TextBlock Text="Agents" Style="{StaticResource TitleText}"/>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}"
                           Text="Back up one agent’s transcript, store, and waypoints, then restore a copy into another workspace."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding Agents.RefreshCommand}"/>
                <Button Content="Open backups" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding Agents.OpenBackupFolderCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Agents.WorkspaceFilters}"
                              SelectedItem="{Binding Agents.SelectedWorkspaceFilter}"
                              DisplayMemberPath="Label"/>
                    <TextBox Grid.Column="2" Text="{Binding Agents.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search agents"/>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <ListBox ItemsSource="{Binding Agents.Agents}"
                                 SelectedItem="{Binding Agents.SelectedAgent}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,8">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding WorkspaceLabel}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding Agents.EmptyAgentsText}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                   Visibility="{Binding Agents.ShowEmptyAgents, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Margin="16,12,16,6" Text="Saved backups" FontWeight="SemiBold"/>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Agents.Backups}"
                                 SelectedItem="{Binding Agents.SelectedBackup}"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,8">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Include" Style="{StaticResource SectionText}"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                                      IsChecked="{Binding Agents.IncludeTranscript, Mode=TwoWay}"
                                      Content="Transcript"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                      IsChecked="{Binding Agents.IncludeStore, Mode=TwoWay}"
                                      Content="This agent’s store"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                      IsChecked="{Binding Agents.IncludeWaypoints, Mode=TwoWay}"
                                      Content="Waypoints (checkpoints)"/>
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionText}"
                                       Text="The original agent is left in place. Restore creates a new copy in the target workspace."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Target workspace" Style="{StaticResource SectionText}"/>
                            <TextBlock Margin="0,6,0,10" Style="{StaticResource MutedText}"
                                       Text="Must already have been opened in Cursor."/>
                            <ComboBox ItemsSource="{Binding Agents.TargetWorkspaces}"
                                      SelectedItem="{Binding Agents.SelectedTargetWorkspace}"
                                      DisplayMemberPath="Label"/>
                            <Button Content="Browse…" Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Command="{Binding Agents.BrowseTargetWorkspaceCommand}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <Button Content="Backup selected agent" Style="{StaticResource GhostButton}"
                                    Command="{Binding Agents.BackupSelectedCommand}"/>
                            <Button Content="Restore agent to workspace" Style="{StaticResource PrimaryButton}"
                                    Margin="0,10,0,0" Command="{Binding Agents.RestoreSelectedAgentCommand}"/>
                            <Button Content="Restore selected backup" Style="{StaticResource GhostButton}"
                                    Margin="0,10,0,0" Command="{Binding Agents.RestoreSelectedBackupCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="CursorSync.Views.AgentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="WorkspaceComboItem">
            <StackPanel Margin="0,1">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{Binding FolderPath}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding FolderPath, Converter={StaticResource NullToVis}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource PageHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Agents" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Style="{StaticResource PageHeaderActions}">
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding Agents.RefreshCommand}"/>
                <Button Content="Import zip…" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding Agents.ImportZipCommand}"/>
                <Button Content="Import folder…" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding Agents.ImportFolderCommand}"/>
                <Button Content="Open backups" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding Agents.OpenBackupFolderCommand}"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Style="{StaticResource PageLead}"
                       Text="Back up agents, restore CursorSync packs, or import an older zip / a folder you copied yourself. Imports are integrity-checked before anything is written."/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" MinWidth="360"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="0.85*" MinHeight="160"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Workspaces on this PC" Style="{StaticResource CaptionText}"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Agents.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Select all" Style="{StaticResource GhostButton}" Padding="12,8" Command="{Binding Agents.SelectAllCommand}"/>
                            <Button Content="None" Style="{StaticResource GhostButton}" Padding="12,8" Margin="6,0,0,0" Command="{Binding Agents.SelectNoneCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Agents.Workspaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SoftCard}" Margin="4,4" Padding="12">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource ListCheckBox}"
                                                              IsThreeState="True"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding FolderPath}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                                       Visibility="{Binding FolderPath, Converter={StaticResource NullToVis}}"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource CaptionText}"
                                                               VerticalAlignment="Top" Margin="12,2,0,0"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Agents}" Margin="28,10,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,4" CornerRadius="8" Padding="8,6" Cursor="Hand"
                                                                    PreviewMouseLeftButtonDown="AgentRow_PreviewMouseLeftButtonDown"
                                                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <CheckBox Style="{StaticResource ListCheckBox}"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                                            <Run Text="{Binding Detail, Mode=OneWay}"/>
                                                                            <Run Text=" · "/>
                                                                            <Run Text="{Binding Meta, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </CheckBox>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding Agents.EmptyAgentsText}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                   Visibility="{Binding Agents.ShowEmptyAgents, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="4,12,4,0">
                    <TextBlock Text="{Binding Agents.SelectionSummary}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                    <Button Content="{Binding Agents.BackupButtonText}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding Agents.BackupSelectedCommand}"/>
                    <Button Content="Delete checked chats" Style="{StaticResource DangerButton}" Margin="0,8,0,0"
                            Command="{Binding Agents.DeleteSelectedAgentsCommand}"/>
                </StackPanel>

                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="16,12,16,6">
                            <TextBlock Text="Saved backups" FontWeight="SemiBold"/>
                            <TextBlock Text="Pick a pack, then restore it on the right." Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Agents.Backups}"
                                 SelectedItem="{Binding Agents.SelectedBackup}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Chip}" Margin="0,0,8,0" Padding="7,2">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="11"/>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="220"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Conversation preview" Style="{StaticResource SectionText}"/>
                            <TextBlock Text="Click an agent on the left to see how the chat started and how it ended."
                                       Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Agents.FocusedAgent.Title}" FontWeight="SemiBold" Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Agents.FocusedAgent, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="{Binding Agents.Preview.Status}" Style="{StaticResource CaptionText}" Margin="0,4,0,10"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding Agents.Preview.HasContent, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Beginning" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="You" Style="{StaticResource CaptionText}" Margin="0,8,0,4"
                                                   Visibility="{Binding Agents.Preview.OpeningUser, Converter={StaticResource NullToVis}}"/>
                                        <TextBlock Text="{Binding Agents.Preview.OpeningUser}" TextWrapping="Wrap"
                                                   Visibility="{Binding Agents.Preview.OpeningUser, Converter={StaticResource NullToVis}}"/>
                                        <TextBlock Text="Agent" Style="{StaticResource CaptionText}" Margin="0,10,0,4"
                                                   Visibility="{Binding Agents.Preview.OpeningAssistant, Converter={StaticResource NullToVis}}"/>
                                        <TextBlock Text="{Binding Agents.Preview.OpeningAssistant}" Style="{StaticResource MutedText}"
                                                   Visibility="{Binding Agents.Preview.OpeningAssistant, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12" Margin="0,12,0,0"
                                        Visibility="{Binding Agents.Preview.HasClosing, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Latest" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="You" Style="{StaticResource CaptionText}" Margin="0,8,0,4"
                                                   Visibility="{Binding Agents.Preview.ClosingUser, Converter={StaticResource NullToVis}}"/>
                                        <TextBlock Text="{Binding Agents.Preview.ClosingUser}" TextWrapping="Wrap"
                                                   Visibility="{Binding Agents.Preview.ClosingUser, Converter={StaticResource NullToVis}}"/>
                                        <TextBlock Text="Agent" Style="{StaticResource CaptionText}" Margin="0,10,0,4"
                                                   Visibility="{Binding Agents.Preview.ClosingAssistant, Converter={StaticResource NullToVis}}"/>
                                        <TextBlock Text="{Binding Agents.Preview.ClosingAssistant}" Style="{StaticResource MutedText}"
                                                   Visibility="{Binding Agents.Preview.ClosingAssistant, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
            <TextBlock Text="Restore, import, or copy" Style="{StaticResource SectionText}"/>
            <TextBlock Text="{Binding Agents.RestoreHint}" Style="{StaticResource CaptionText}" Margin="0,6,0,12"/>

                        <RadioButton Style="{StaticResource OptionRadio}" GroupName="AgentRestoreMode"
                                     IsChecked="{Binding Agents.ForceRestoreTarget, Converter={StaticResource InverseBool}, Mode=TwoWay}"
                                     Content="Put agents back in their original workspaces"/>
                        <RadioButton Style="{StaticResource OptionRadio}" GroupName="AgentRestoreMode" Margin="0,0,0,12"
                                     IsChecked="{Binding Agents.ForceRestoreTarget, Mode=TwoWay}"
                                     Content="Put every agent into one workspace"/>

                        <TextBlock Text="Destination workspace" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Agents.TargetWorkspaces}"
                                  SelectedItem="{Binding Agents.SelectedTargetWorkspace}"
                                  ItemTemplate="{StaticResource WorkspaceComboItem}"/>
                        <Button Content="Browse folder…" Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                                HorizontalAlignment="Left" Command="{Binding Agents.BrowseTargetWorkspaceCommand}"/>

                        <TextBlock Text="Include" Style="{StaticResource CaptionText}" Margin="0,16,0,8"/>
                        <CheckBox Style="{StaticResource ListCheckBox}" Margin="0,0,0,8"
                                  IsChecked="{Binding Agents.IncludeTranscript, Mode=TwoWay}"
                                  Content="Conversation transcript"/>
                        <CheckBox Style="{StaticResource ListCheckBox}" Margin="0,0,0,8"
                                  IsChecked="{Binding Agents.IncludeStore, Mode=TwoWay}"
                                  Content="Agent memory store"/>
                        <CheckBox Style="{StaticResource ListCheckBox}"
                                  IsChecked="{Binding Agents.IncludeWaypoints, Mode=TwoWay}"
                                  Content="Checkpoints / waypoints"/>

                        <Button Content="Restore selected backup" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                                Command="{Binding Agents.RestoreSelectedBackupCommand}"/>
                        <Button Content="Import zip…" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                Command="{Binding Agents.ImportZipCommand}"/>
                        <Button Content="Import folder…" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                Command="{Binding Agents.ImportFolderCommand}"/>
                        <Button Content="Copy checked agents into destination" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                Command="{Binding Agents.CopySelectedToWorkspaceCommand}"/>
                        <Button Content="Assign checked agents to destination" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                Command="{Binding Agents.AssignSelectedToWorkspaceCommand}"/>
                        <Button Content="Delete checked chats" Style="{StaticResource DangerButton}" Margin="0,8,0,0"
                                Command="{Binding Agents.DeleteSelectedAgentsCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

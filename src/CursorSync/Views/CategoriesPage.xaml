<UserControl x:Class="CursorSync.Views.CategoriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,12,16">
            <StackPanel>
                <TextBlock Text="Data to sync" Style="{StaticResource TitleText}"/>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}"
                           Text="Only enabled categories are copied. Leave bulky items off unless you really need them."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Recommended" Style="{StaticResource GhostButton}" Command="{Binding EnableRecommendedCommand}"/>
                <Button Content="All" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding EnableAllCommand}"/>
                <Button Content="None" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding EnableNoneCommand}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,12">
            <ItemsControl ItemsSource="{Binding CategoryGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionText}"/>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="0,4,0,10"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                                        <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Background="{StaticResource WarnSoftBrush}"
                                                                Visibility="{Binding RequiresCursorClosed, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Close Cursor" FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}" Margin="8,0,0,0"
                                                                Visibility="{Binding IsLarge, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Large" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center"
                                                           Style="{StaticResource CaptionText}" Margin="0,0,16,0"/>
                                                <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

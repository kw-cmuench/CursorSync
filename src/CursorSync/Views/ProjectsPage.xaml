<UserControl x:Class="CursorSync.Views.ProjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="WorkspaceComboItem">
            <StackPanel Margin="0,1">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{Binding FolderPath}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding FolderPath, Converter={StaticResource NullToVis}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource PageHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Projects" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Style="{StaticResource PageHeaderActions}">
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding ProjectManager.RefreshCommand}"/>
                <Button Content="Clean up…" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Command="{Binding ProjectManager.CleanupProjectsCommand}"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Style="{StaticResource PageLead}"
                       Text="Manage Cursor’s ~/.cursor/projects cache: move transcripts into a real workspace, rename, delete, or clean unused folders. Source code is never deleted."/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="340"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Text="{Binding ProjectManager.SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <ListBox ItemsSource="{Binding ProjectManager.Items}"
                                 SelectedItem="{Binding ProjectManager.SelectedProject}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6">
                                        <CheckBox Style="{StaticResource ListCheckBox}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                                    <Run Text="{Binding StatusText, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding AgentCountText, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding ProjectManager.EmptyText}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                   Visibility="{Binding ProjectManager.ShowEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2" Text="{Binding ProjectManager.SafetyNote}"
                           Style="{StaticResource CaptionText}" Margin="4,12,4,0" TextWrapping="Wrap"/>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Selected project" Style="{StaticResource SectionText}"/>
                            <TextBlock Text="{Binding ProjectManager.SelectedProject.Label}" FontWeight="SemiBold" Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ProjectManager.SelectedProject, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="{Binding ProjectManager.SelectedProject.DetailText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ProjectManager.SelectedProject, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="Select a project cache on the left." Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                       Visibility="{Binding ProjectManager.SelectedProject, Converter={StaticResource InverseNullToVis}}"/>

                            <TextBlock Text="Name" Style="{StaticResource CaptionText}" Margin="0,14,0,6"
                                       Visibility="{Binding ProjectManager.SelectedProject, Converter={StaticResource NullToVis}}"/>
                            <TextBox Text="{Binding ProjectManager.RenameText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding ProjectManager.SelectedProject, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="{Binding ProjectManager.RenameHint}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                            <Button Content="Rename…" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    Command="{Binding ProjectManager.RenameProjectCommand}"/>
                            <Button Content="Open cache folder" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    Command="{Binding ProjectManager.OpenSelectedCacheCommand}"/>
                            <Button Content="Open project folder" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    Command="{Binding ProjectManager.OpenSelectedFolderCommand}"/>
                            <Button Content="Open in Cursor" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    Command="{Binding ProjectManager.OpenSelectedInCursorCommand}"/>
                            <Button Content="Delete this project" Style="{StaticResource DangerButton}" Margin="0,14,0,0"
                                    Command="{Binding ProjectManager.DeleteProjectCommand}"/>
                            <Button Content="Delete checked projects" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    Command="{Binding ProjectManager.DeleteCheckedProjectsCommand}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Move data to a workspace" Style="{StaticResource SectionText}"/>
                            <TextBlock Text="{Binding ProjectManager.MoveHint}" Style="{StaticResource CaptionText}" Margin="0,6,0,10"/>
                            <TextBlock Text="Destination workspace" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding ProjectManager.MoveTargets}"
                                      SelectedItem="{Binding ProjectManager.SelectedMoveTarget}"
                                      ItemTemplate="{StaticResource WorkspaceComboItem}"/>
                            <Button Content="Move into destination" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                    Command="{Binding ProjectManager.MoveToWorkspaceCommand}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Clean up" Style="{StaticResource SectionText}"/>
                            <TextBlock Text="{Binding ProjectManager.CleanupHint}" Style="{StaticResource CaptionText}" Margin="0,6,0,10"/>
                            <Button Content="Clean up unused and unusable" Style="{StaticResource DangerButton}"
                                    Command="{Binding ProjectManager.CleanupProjectsCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

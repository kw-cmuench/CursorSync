<UserControl x:Class="CursorSync.Views.WorkspacesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="WorkspaceComboItem">
            <StackPanel Margin="0,1">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{Binding FolderPath}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding FolderPath, Converter={StaticResource NullToVis}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource PageHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Workspaces" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Style="{StaticResource PageHeaderActions}">
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding WorkspaceManager.RefreshCommand}"/>
                <Button Content="Add folder…" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Command="{Binding WorkspaceManager.AddWorkspaceCommand}"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Style="{StaticResource PageLead}"
                           Text="Add, rename, retarget, split, merge, or delete Cursor project folders without inventing workspace IDs. Assign agents on the Agents page or merge them here."/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="340"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Text="{Binding WorkspaceManager.SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <ListBox ItemsSource="{Binding WorkspaceManager.Items}"
                                 SelectedItem="{Binding WorkspaceManager.SelectedWorkspace}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource ListCheckBox}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding FolderPath}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                                        <Run Text="{Binding StatusText, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding AgentCountText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </CheckBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding WorkspaceManager.EmptyText}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                   Visibility="{Binding WorkspaceManager.ShowEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2" Text="{Binding WorkspaceManager.SafetyNote}"
                           Style="{StaticResource CaptionText}" Margin="4,12,4,0" TextWrapping="Wrap"/>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Selected workspace" Style="{StaticResource SectionText}"/>
                            <TextBlock Text="{Binding WorkspaceManager.SelectedWorkspace.Label}" FontWeight="SemiBold" Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding WorkspaceManager.SelectedWorkspace, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="{Binding WorkspaceManager.SelectedWorkspace.FolderPath}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding WorkspaceManager.SelectedWorkspace, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="Select a workspace on the left." Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                       Visibility="{Binding WorkspaceManager.SelectedWorkspace, Converter={StaticResource InverseNullToVis}}"/>

                            <TextBlock Text="Name" Style="{StaticResource CaptionText}" Margin="0,14,0,6"
                                       Visibility="{Binding WorkspaceManager.SelectedWorkspace, Converter={StaticResource NullToVis}}"/>
                            <TextBox Text="{Binding WorkspaceManager.RenameText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding WorkspaceManager.SelectedWorkspace, Converter={StaticResource NullToVis}}"/>
                            <Button Content="Rename folder…" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    Command="{Binding WorkspaceManager.RenameWorkspaceCommand}"/>
                            <Button Content="Edit folder path…" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    Command="{Binding WorkspaceManager.EditWorkspaceCommand}"/>
                            <Button Content="Open folder" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    Command="{Binding WorkspaceManager.OpenSelectedFolderCommand}"/>
                            <Button Content="Open in Cursor" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    Command="{Binding WorkspaceManager.OpenSelectedInCursorCommand}"/>
                            <Button Content="Delete this workspace" Style="{StaticResource DangerButton}" Margin="0,14,0,0"
                                    Command="{Binding WorkspaceManager.DeleteWorkspaceCommand}"/>
                            <Button Content="Delete checked workspaces" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    Command="{Binding WorkspaceManager.DeleteCheckedWorkspacesCommand}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Split into subfolders" Style="{StaticResource SectionText}"/>
                            <TextBlock Text="{Binding WorkspaceManager.SplitHint}" Style="{StaticResource CaptionText}" Margin="0,6,0,10"/>
                            <ItemsControl ItemsSource="{Binding WorkspaceManager.SplitChildren}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource ListCheckBox}" Margin="0,0,0,8"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Open checked folders in Cursor" Style="{StaticResource GhostButton}" Margin="0,4,0,0"
                                    Command="{Binding WorkspaceManager.OpenSplitChildrenInCursorCommand}"/>
                            <Button Content="Split selected" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                                    Command="{Binding WorkspaceManager.SplitSelectedCommand}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Merge agents" Style="{StaticResource SectionText}"/>
                            <TextBlock Text="{Binding WorkspaceManager.MergeHint}" Style="{StaticResource CaptionText}" Margin="0,6,0,10"/>
                            <TextBlock Text="Destination workspace" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding WorkspaceManager.MergeTargets}"
                                      SelectedItem="{Binding WorkspaceManager.SelectedMergeTarget}"
                                      ItemTemplate="{StaticResource WorkspaceComboItem}"/>
                            <Button Content="Merge checked workspaces into destination" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                    Command="{Binding WorkspaceManager.MergeSelectedCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

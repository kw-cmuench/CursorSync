<UserControl x:Class="CursorSync.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,24">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource TitleText}"/>
            <TextBlock Margin="0,6,0,18" Style="{StaticResource MutedText}"
                       Text="Point both machines at the same folder. Cursor account login stays in Cursor — this app only copies local data."/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Sync folder" Style="{StaticResource SectionText}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,12"
                               Text="Use OneDrive, Dropbox, a USB drive, or a network share. Install CursorSync on every PC and select this same folder."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding HubPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Browse" Style="{StaticResource GhostButton}" Command="{Binding BrowseHubCommand}"/>
                            <Button Content="Open" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding OpenHubCommand}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Suggestions" Style="{StaticResource CaptionText}" Margin="0,14,0,8"/>
                    <ItemsControl ItemsSource="{Binding SuggestedHubs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8" Padding="12,8"
                                        Command="{Binding DataContext.UseSuggestedHubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding FolderPath}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding FolderPath}" Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="This machine" Style="{StaticResource SectionText}"/>
                    <TextBlock Text="Name shown in the hub manifest and history." Style="{StaticResource MutedText}" Margin="0,6,0,10"/>
                    <TextBox Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}" MaxWidth="360" HorizontalAlignment="Left"/>

                    <TextBlock Text="Custom Cursor user-data folder" Style="{StaticResource CaptionText}" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CursorUserDataDir, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding BrowseCursorDataCommand}"/>
                    </Grid>
                    <TextBlock Text="Leave empty for %APPDATA%\Cursor. Use this for portable installs or --user-data-dir." Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Safety" Style="{StaticResource SectionText}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                              IsChecked="{Binding BackupBeforePull, Mode=TwoWay}" Content="Backup selected local data before pull"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                              IsChecked="{Binding CloseCursorBeforeSync, Mode=TwoWay}" Content="Try to close Cursor before syncing locked databases"/>
                    <Button Content="Open backups folder" Style="{StaticResource GhostButton}" Margin="0,16,0,0" HorizontalAlignment="Left" Command="{Binding OpenBackupsCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Two-way conflicts" Style="{StaticResource SectionText}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,12" Text="Used when the same file exists on this PC and in the sync folder."/>
                    <RadioButton GroupName="Conflict" Margin="0,0,0,8" Foreground="{StaticResource TextBrush}"
                                 IsChecked="{Binding ConflictPolicy, Converter={StaticResource EnumEquals}, ConverterParameter=NewerWins}"
                                 Content="Newer file wins"/>
                    <RadioButton GroupName="Conflict" Margin="0,0,0,8" Foreground="{StaticResource TextBrush}"
                                 IsChecked="{Binding ConflictPolicy, Converter={StaticResource EnumEquals}, ConverterParameter=PreferLocal}"
                                 Content="Prefer this PC"/>
                    <RadioButton GroupName="Conflict" Foreground="{StaticResource TextBrush}"
                                 IsChecked="{Binding ConflictPolicy, Converter={StaticResource EnumEquals}, ConverterParameter=PreferHub}"
                                 Content="Prefer the sync folder"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Project path rewrite on pull" Style="{StaticResource SectionText}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,12"
                               Text="Chats are tied to folder paths inside workspace.json. If your repos live on a different drive letter, rewrite the old prefix to the new one."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Replace" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding PathReplaceFrom, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="With" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding PathReplaceTo, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionText}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                               Text="CursorSync 1.0 copies local Cursor data between Windows PCs. It does not replace Cursor’s cloud account, and it never syncs logs, caches, or login tokens."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

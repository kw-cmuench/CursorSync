<Window x:Class="CursorSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:CursorSync.Views"
        Title="CursorSync"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="760" Width="1180"
        MinHeight="640" MinWidth="980"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="22,22,22,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF6D8BFF" Offset="0"/>
                                    <GradientStop Color="#FF8B7CFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CursorSync" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="Account data" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="8,8,8,0">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Dashboard}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" Width="22"/>
                            <TextBlock Text="Dashboard" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Categories}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Categories">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Width="22"/>
                            <TextBlock Text="Data" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Sync}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Sync">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" Width="22"/>
                            <TextBlock Text="Sync" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=History}"
                                 Command="{Binding NavigateCommand}" CommandParameter="History">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" Width="22"/>
                            <TextBlock Text="History" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Settings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" Width="22"/>
                            <TextBlock Text="Settings" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border Grid.Row="2" Margin="16,8,16,18" Style="{StaticResource SoftCard}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding MachineName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CursorStatusText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                        <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="0,10,0,0" Padding="10,6"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource BgBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="28,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimize"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Style="{StaticResource CaptionIcon}" Data="M 0,5.5 H 11"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="Maximize"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="11" Height="11">
                                <Path x:Name="MaximizeIcon" Style="{StaticResource CaptionIcon}" Data="M 0.5,0.5 H 10.5 V 10.5 H 0.5 Z"/>
                                <Path x:Name="RestoreIcon" Style="{StaticResource CaptionIcon}" Visibility="Collapsed"
                                      Data="M 3.5,0.5 H 10.5 V 7.5 H 8.5 M 8.5,3.5 H 0.5 V 10.5 H 8.5 V 3.5"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource CloseWindowButton}" Click="Close_Click" ToolTip="Close"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Style="{StaticResource CaptionIcon}" Data="M 0.5,0.5 L 10.5,10.5 M 10.5,0.5 L 0.5,10.5"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="28,0,28,0" CornerRadius="10" Padding="12,10"
                    Visibility="{Binding BannerText, Converter={StaticResource NullToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BannerKind}" Value="success">
                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BannerKind}" Value="warn">
                                <Setter Property="Background" Value="{StaticResource WarnSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BannerKind}" Value="error">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap"/>
            </Border>

            <Grid Grid.Row="2" Margin="28,18,16,16">
                <views:DashboardPage Visibility="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Dashboard}"/>
                <views:CategoriesPage Visibility="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Categories}"/>
                <views:SyncPage Visibility="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Sync}"/>
                <views:HistoryPage Visibility="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=History}"/>
                <views:SettingsPage Visibility="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Settings}"/>
            </Grid>
        </Grid>

        <Border Grid.ColumnSpan="2" Background="#99000000"
                Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="440" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmTitle}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ConfirmMessage}" Style="{StaticResource MutedText}" Margin="0,10,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelConfirmCommand}"/>
                        <Button Content="Continue" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding ConfirmCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

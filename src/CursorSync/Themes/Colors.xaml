<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#FF0E1117</Color>
    <Color x:Key="SidebarColor">#FF12161E</Color>
    <Color x:Key="SurfaceColor">#FF171C26</Color>
    <Color x:Key="SurfaceAltColor">#FF1D2430</Color>
    <Color x:Key="BorderColor">#FF2A3344</Color>
    <Color x:Key="TextColor">#FFF2F5FA</Color>
    <Color x:Key="MutedColor">#FF9AA6B8</Color>
    <Color x:Key="AccentColor">#FF6D8BFF</Color>
    <Color x:Key="Accent2Color">#FF8B7CFF</Color>
    <Color x:Key="SuccessColor">#FF3DDC97</Color>
    <Color x:Key="WarnColor">#FFF5C14A</Color>
    <Color x:Key="DangerColor">#FFFF6B7A</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#336D8BFF"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#33FF6B7A"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#223DDC97"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#33F5C14A"/>
</ResourceDictionary>
